# --- Build ---
# build/, CM4/build/, CM7/build/, plus ExternalProject's tmp/, src/, stamp/.
build/
build-*/
CM4/build-*/
CM7/build-*/

# --- Local tool state ---
.vscode
# CubeMX / CubeCLT: ide.store.json, bundles*.store.json
.settings/
# clangd index
.cache/
# CubeMX internal state
.mxproject
CMakeUserPresets.json

# --- Vendored libraries ---
# Not kept in the repository: CubeMX takes them from CUBE_FW_PATH.
/Drivers/
/Middlewares/

# --- Root configure guard ---
# Out-of-source build; `cmake .` here would litter the repo.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
Makefile

# ... but not the host test harness, which the pattern above hid.
!Common/test/Makefile

# Python tooling
__pycache__/
*.pyc
.venv/

# SDR captures
*.iq
*.iq.meta

# Host test binaries
Common/test/test_hop
Common/test/test_slots
Common/test/test_link
Common/test/test_ipc
Common/test/test_oht
